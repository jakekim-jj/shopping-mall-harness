{
  "name": "shopping-mall-harness",
  "version": "1.0.0",
  "private": true,
  "description": "AI agent harness for a shopping-mall MVP — planner/backend/frontend/QA cycle with Playwright regression suite",
  "type": "commonjs",
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "test": "node ./node_modules/@playwright/test/cli.js test",
    "test:headed": "node ./node_modules/@playwright/test/cli.js test --headed --workers=1"
  },
  "dependencies": {
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1"
  }
}
